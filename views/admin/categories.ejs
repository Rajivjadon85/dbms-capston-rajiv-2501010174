<%- include('../layouts/header') %>

<div class="page-header">
    <div>
        <h2><i class="bi bi-tags text-primary me-2"></i>Academic Category Management</h2>
        <p class="text-muted mb-0 small">Organize books into normalized subject categories (2NF / 3NF)</p>
    </div>
</div>

<div class="row g-4">
    <!-- Add Category Form Card -->
    <div class="col-lg-4">
        <div class="card card-custom p-4 bg-white">
            <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle text-primary me-2"></i>Add New Category</h5>
            <form action="/admin/categories/add" method="POST">
                <div class="mb-3">
                    <label for="category_name" class="form-label">Category Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="category_name" name="category_name" placeholder="e.g. Cloud Computing" required>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description / Scope</label>
                    <textarea class="form-control" id="description" name="description" rows="3" placeholder="Brief description of subjects covered..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-save me-1"></i> Save Category
                </button>
            </form>
        </div>
    </div>

    <!-- Categories List Table -->
    <div class="col-lg-8">
        <div class="card card-custom p-3 bg-white">
            <h5 class="fw-bold mb-3"><i class="bi bi-list-nested text-secondary me-2"></i>Existing Categories (<%= categories.length %>)</h5>
            
            <div class="table-responsive">
                <table class="table table-custom align-middle">
                    <thead>
                        <tr>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th class="text-center">Books Count</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (categories && categories.length > 0) { %>
                            <% categories.forEach(cat => { %>
                                <tr>
                                    <td class="fw-bold text-dark"><%= cat.category_name %></td>
                                    <td class="text-muted small" style="max-width: 250px;"><%= cat.description || 'No description provided' %></td>
                                    <td class="text-center">
                                        <span class="badge bg-primary rounded-pill"><%= cat.book_count %> Books</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editModal<%= cat.category_id %>" title="Edit Category">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form action="/admin/categories/delete/<%= cat.category_id %>" method="POST" class="d-inline confirm-delete-form" data-item-type="category">
                                                <button type="submit" class="btn btn-outline-danger" title="Delete Category" <%= cat.book_count > 0 ? 'title="Cannot delete: Books exist in this category"' : '' %>>
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>

                                        <!-- Edit Modal -->
                                        <div class="modal fade text-start" id="editModal<%= cat.category_id %>" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form action="/admin/categories/edit/<%= cat.category_id %>" method="POST">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold">Edit Category</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label">Category Name</label>
                                                                <input type="text" class="form-control" name="category_name" value="<%= cat.category_name %>" required>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label">Description</label>
                                                                <textarea class="form-control" name="description" rows="3"><%= cat.description || '' %></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-primary">Update Category</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No categories created yet.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
