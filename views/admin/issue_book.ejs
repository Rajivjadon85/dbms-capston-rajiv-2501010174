<%- include('../layouts/header') %>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom p-4 shadow-sm bg-white">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <div>
                    <h3 class="fw-bold text-dark mb-0">
                        <i class="bi bi-box-arrow-up-right text-primary me-2"></i>Issue Book to Student
                    </h3>
                    <p class="text-muted small mb-0">Executes an ACID-compliant transaction to assign book and update stock</p>
                </div>
                <a href="/admin/issues" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> View Issue Logs
                </a>
            </div>

            <form action="/admin/issue" method="POST">
                <div class="row g-3">
                    <!-- Book Selection -->
                    <div class="col-12">
                        <label for="book_id" class="form-label">Select Book to Issue <span class="text-danger">*</span></label>
                        <select class="form-select" id="book_id" name="book_id" required>
                            <option value="">-- Choose Book (Showing Available Titles) --</option>
                            <% books.forEach(b => { %>
                                <option value="<%= b.book_id %>" <%= preSelectedBook == b.book_id ? 'selected' : '' %>>
                                    <%= b.title %> by <%= b.author %> (ISBN: <%= b.isbn %>) — [<%= b.available_copies %> in stock]
                                </option>
                            <% }) %>
                        </select>
                        <small class="text-muted">Only books with available copies &gt; 0 are displayed</small>
                    </div>

                    <!-- Student Selection -->
                    <div class="col-md-8">
                        <label for="student_id" class="form-label">Select Registered Student <span class="text-danger">*</span></label>
                        <select class="form-select" id="student_id" name="student_id" required>
                            <option value="">-- Choose Student by Roll Number / Name --</option>
                            <% students.forEach(s => { %>
                                <option value="<%= s.student_id %>" <%= preSelectedStudent == s.student_id ? 'selected' : '' %>>
                                    <%= s.roll_number %> - <%= s.full_name %> (<%= s.department %> Sem <%= s.semester %>)
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <!-- Loan Duration -->
                    <div class="col-md-4">
                        <label for="duration_days" class="form-label">Loan Duration (Days)</label>
                        <input type="number" class="form-control" id="duration_days" name="duration_days" value="<%= defaultDuration %>" min="1" max="60" required>
                        <small class="text-muted">Standard college limit: 14 days</small>
                    </div>

                    <!-- Remarks -->
                    <div class="col-12">
                        <label for="remarks" class="form-label">Remarks / Special Notes</label>
                        <input type="text" class="form-control" id="remarks" name="remarks" placeholder="e.g. For semester project work, verified student ID card">
                    </div>
                </div>

                <!-- Transaction Safety Alert Box -->
                <div class="alert alert-light border mt-4 p-3 small">
                    <div class="fw-bold text-primary mb-1"><i class="bi bi-shield-lock-fill me-1"></i> Transaction Guarantee:</div>
                    <ul class="mb-0 text-muted ps-3">
                        <li>Row-level lock (<code>FOR UPDATE</code>) ensures no two librarians can checkout the same last copy simultaneously.</li>
                        <li>Student status and active loan limits are verified inside an atomic transaction.</li>
                        <li>Catalog availability is automatically decremented upon successful checkout.</li>
                    </ul>
                </div>

                <div class="mt-3 pt-3 border-top d-flex gap-2 justify-content-end">
                    <a href="/admin/dashboard" class="btn btn-light px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i> Confirm & Issue Book
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
