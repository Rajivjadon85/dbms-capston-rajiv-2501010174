<%- include('../layouts/header') %>

<div class="page-header">
    <div>
        <h2><i class="bi bi-arrow-left-right text-primary me-2"></i>Circulation Records & Returns</h2>
        <p class="text-muted mb-0 small">Tracking active borrowings, return confirmations, and late fees</p>
    </div>
    <a href="/admin/issue" class="btn btn-primary btn-sm">
        <i class="bi bi-box-arrow-up-right me-1"></i> Issue New Book
    </a>
</div>

<!-- Filter & Search Card -->
<div class="card card-custom p-3 mb-4 bg-white">
    <form action="/admin/issues" method="GET" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" name="search" value="<%= searchQuery %>" placeholder="Search by Student Roll No, Name, or Book Title...">
            </div>
        </div>

        <div class="col-md-4">
            <select class="form-select" name="status">
                <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>All Statuses (Issued, Returned, Overdue)</option>
                <option value="Issued" <%= selectedStatus === 'Issued' ? 'selected' : '' %>>Currently Issued</option>
                <option value="Overdue" <%= selectedStatus === 'Overdue' ? 'selected' : '' %>>Overdue Loans</option>
                <option value="Returned" <%= selectedStatus === 'Returned' ? 'selected' : '' %>>Returned Loans</option>
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
            <a href="/admin/issues" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Issues Table -->
<div class="card card-custom p-3 bg-white">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0 text-muted">Showing <%= issues.length %> Transaction Records</h6>
        <div style="max-width: 250px;">
            <input type="text" id="tableQuickSearch" class="form-control form-control-sm" placeholder="Quick filter table...">
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-custom align-middle searchable-table">
            <thead>
                <tr>
                    <th>Loan Details</th>
                    <th>Student Info</th>
                    <th>Issue Date</th>
                    <th>Due Date</th>
                    <th>Return Date / Fine</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (issues && issues.length > 0) { %>
                    <% issues.forEach(item => { %>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark"><%= item.book_title %></div>
                                <small class="text-muted"><i class="bi bi-upc-scan me-1"></i><%= item.isbn %> &bull; ID: #<%= item.issue_id %></small>
                                <% if (item.remarks) { %>
                                    <div class="text-secondary small fst-italic"><%= item.remarks %></div>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border fw-bold"><%= item.roll_number %></span>
                                <div><%= item.student_name %></div>
                                <small class="text-muted"><%= item.department %></small>
                            </td>
                            <td><%= item.issue_date %></td>
                            <td>
                                <div><%= item.due_date %></div>
                                <% if (item.status === 'Overdue') { %>
                                    <small class="text-danger fw-bold"><%= item.days_difference %> days overdue</small>
                                <% } %>
                            </td>
                            <td>
                                <% if (item.return_date) { %>
                                    <div><%= item.return_date %></div>
                                    <% if (parseFloat(item.fine_amount) > 0) { %>
                                        <small class="text-danger fw-bold">Fine Paid: ₹<%= parseFloat(item.fine_amount).toFixed(2) %></small>
                                    <% } else { %>
                                        <small class="text-success">No Fine</small>
                                    <% } %>
                                <% } else { %>
                                    <% if (item.status === 'Overdue') { %>
                                        <span class="text-danger fw-bold">Est. Fine: ₹<%= item.calculated_fine %></span>
                                    <% } else { %>
                                        <span class="text-muted small">Not yet returned</span>
                                    <% } %>
                                <% } %>
                            </td>
                            <td>
                                <% if (item.status === 'Issued') { %>
                                    <span class="badge badge-issued">Issued</span>
                                <% } else if (item.status === 'Overdue') { %>
                                    <span class="badge badge-overdue">Overdue</span>
                                <% } else { %>
                                    <span class="badge badge-returned">Returned</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <% if (item.status !== 'Returned') { %>
                                    <form action="/admin/return/<%= item.issue_id %>" method="POST" class="d-inline confirm-return-form">
                                        <button type="submit" class="btn btn-sm btn-success fw-semibold" title="Accept Return of Book">
                                            <i class="bi bi-check2-circle me-1"></i> Accept Return
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span class="badge bg-light text-muted border">Completed</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-journal-x fs-2 d-block mb-2"></i>
                            No circulation records found matching criteria.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../layouts/footer') %>
