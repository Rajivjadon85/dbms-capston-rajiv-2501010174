<%- include('../layouts/header') %>

<div class="page-header">
    <div>
        <h2><i class="bi bi-people text-primary me-2"></i>Registered Students Directory</h2>
        <p class="text-muted mb-0 small">Student membership, active borrowing quotas, and account status</p>
    </div>
</div>

<!-- Search Bar -->
<div class="card card-custom p-3 mb-4 bg-white">
    <form action="/admin/students" method="GET" class="row g-2 align-items-center">
        <div class="col-md-9">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" name="search" value="<%= searchQuery %>" placeholder="Search by Roll Number, Student Name, or Email...">
            </div>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Search Students</button>
            <a href="/admin/students" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Students Table -->
<div class="card card-custom p-3 bg-white">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0 text-muted">Total Students: <%= students.length %></h6>
        <div style="max-width: 250px;">
            <input type="text" id="tableQuickSearch" class="form-control form-control-sm" placeholder="Quick filter table...">
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-custom align-middle searchable-table">
            <thead>
                <tr>
                    <th>Roll Number</th>
                    <th>Student Name</th>
                    <th>Contact Info</th>
                    <th>Dept & Semester</th>
                    <th class="text-center">Active Loans</th>
                    <th>Account Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                <% if (students && students.length > 0) { %>
                    <% students.forEach(s => { %>
                        <tr>
                            <td><span class="badge bg-light text-dark border fw-bold fs-6"><%= s.roll_number %></span></td>
                            <td>
                                <div class="fw-bold text-dark"><%= s.full_name %></div>
                                <small class="text-muted">Registered: <%= new Date(s.created_at).toLocaleDateString() %></small>
                            </td>
                            <td>
                                <div><i class="bi bi-envelope me-1 text-secondary"></i><%= s.email %></div>
                                <small class="text-muted"><i class="bi bi-telephone me-1"></i><%= s.phone || 'N/A' %></small>
                            </td>
                            <td>
                                <span class="badge bg-info text-dark me-1"><%= s.department %></span>
                                <span class="badge bg-secondary">Sem <%= s.semester %></span>
                            </td>
                            <td class="text-center">
                                <% if (s.active_borrowed_count > 0) { %>
                                    <span class="badge bg-warning text-dark"><%= s.active_borrowed_count %> Active</span>
                                <% } else { %>
                                    <span class="badge bg-light text-muted border">0 Books</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (s.status === 'Active') { %>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle me-1"></i>Active
                                    </span>
                                <% } else { %>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                        <i class="bi bi-x-octagon me-1"></i>Blocked
                                    </span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <form action="/admin/students/toggle-status/<%= s.student_id %>" method="POST" class="d-inline">
                                    <% if (s.status === 'Active') { %>
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Block Student Account">
                                            <i class="bi bi-slash-circle me-1"></i> Block
                                        </button>
                                    <% } else { %>
                                        <button type="submit" class="btn btn-outline-success btn-sm" title="Activate Student Account">
                                            <i class="bi bi-check2-circle me-1"></i> Unblock
                                        </button>
                                    <% } %>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No student records found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../layouts/footer') %>
