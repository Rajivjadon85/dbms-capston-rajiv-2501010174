<%- include('../layouts/header') %>

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom p-4 shadow-sm">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle p-3 mb-2" style="width: 60px; height: 60px;">
                    <i class="bi bi-box-arrow-in-right fs-3"></i>
                </div>
                <h3 class="fw-bold text-dark">Portal Sign In</h3>
                <p class="text-muted small">Select your role to access library services</p>
            </div>

            <!-- Role Switch Tabs -->
            <ul class="nav nav-pills nav-fill mb-4 p-1 bg-light rounded-3" id="loginTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link <%= activeTab === 'student' ? 'active' : '' %> fw-semibold" id="student-tab" data-bs-toggle="pill" data-bs-target="#student-login" type="button" role="tab" aria-controls="student-login" aria-selected="<%= activeTab === 'student' %>">
                        <i class="bi bi-person me-1"></i> Student Login
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link <%= activeTab === 'admin' ? 'active' : '' %> fw-semibold" id="admin-tab" data-bs-toggle="pill" data-bs-target="#admin-login" type="button" role="tab" aria-controls="admin-login" aria-selected="<%= activeTab === 'admin' %>">
                        <i class="bi bi-shield-lock me-1"></i> Admin Login
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="loginTabsContent">
                <!-- Student Login Form -->
                <div class="tab-pane fade <%= activeTab === 'student' ? 'show active' : '' %>" id="student-login" role="tabpanel" aria-labelledby="student-tab">
                    <form action="/auth/login/student" method="POST">
                        <div class="mb-3">
                            <label for="studentIdentifier" class="form-label">College Roll Number or Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                                <input type="text" class="form-control" id="studentIdentifier" name="identifier" placeholder="e.g. 23CS001" required autofocus>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="studentPassword" class="form-label">Password</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input type="password" class="form-control" id="studentPassword" name="password" placeholder="••••••••" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In as Student
                        </button>
                    </form>

                    <div class="text-center mt-3 pt-3 border-top">
                        <span class="text-muted small">New student? </span>
                        <a href="/auth/register" class="fw-semibold text-decoration-none">Register College Account</a>
                    </div>
                </div>

                <!-- Admin Login Form -->
                <div class="tab-pane fade <%= activeTab === 'admin' ? 'show active' : '' %>" id="admin-login" role="tabpanel" aria-labelledby="admin-tab">
                    <form action="/auth/login/admin" method="POST">
                        <div class="mb-3">
                            <label for="adminUsername" class="form-label">Admin Username</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                                <input type="text" class="form-control" id="adminUsername" name="username" placeholder="admin" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="adminPassword" class="form-label">Admin Password</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                                <input type="password" class="form-control" id="adminPassword" name="password" placeholder="••••••••" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold">
                            <i class="bi bi-shield-lock-fill me-1"></i> Sign In to Admin Console
                        </button>
                    </form>
                </div>
            </div>

            <!-- Demo Credentials Helper Card -->
            <div class="mt-4 p-3 bg-light rounded-3 border">
                <div class="d-flex align-items-center mb-1 text-primary">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <strong class="small">Demo & Viva Test Credentials</strong>
                </div>
                <div class="row g-2 mt-1 small">
                    <div class="col-6">
                        <div class="p-2 bg-white rounded border">
                            <span class="d-block text-muted">Admin User:</span>
                            <code>admin / admin123</code>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 bg-white rounded border">
                            <span class="d-block text-muted">Student User:</span>
                            <code>23CS001 / student123</code>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
